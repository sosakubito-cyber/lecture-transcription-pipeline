# Copy this file to .env locally if needed.
# Do not commit real API keys, tokens, passwords, or service account JSON files.

OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=

# Absolute path to a local Google Cloud service account JSON.
# Example: /Users/yourname/Desktop/google_speech_service_account.json
GOOGLE_APPLICATION_CREDENTIALS=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_LOCATION=asia-northeast1

# Optional path to a local Deepgram API key file.
DEEPGRAM_API_KEY_FILE=
